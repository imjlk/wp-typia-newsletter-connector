{
	"name": "wp-typia-newsletter-connector",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@8.15.9",
	"engines": {
		"node": ">=24.0.0"
	},
	"description": "Newspack Newsletters companion ESP provider for Listmonk campaigns",
	"author": "imjlk",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"sync": "tsx scripts/sync-project.ts",
		"sync-types": "tsx scripts/sync-types-to-block-json.ts",
		"sync-rest": "tsx scripts/sync-rest-contracts.ts",
		"build": "pnpm run sync --check && node scripts/build-workspace.mjs build",
		"release:zip": "node scripts/release-zip.mjs",
		"release:wporg": "node scripts/release-wporg.mjs",
		"release:sync-version": "node scripts/sync-release-version.mjs",
		"release:check-version": "node scripts/sync-release-version.mjs --check",
		"release:prepare": "node scripts/prepare-sampo-release.mjs",
		"changeset:add": "sampo add",
		"review:plugin-check": "node scripts/review-plugin-check.mjs",
		"start": "pnpm run sync && node scripts/build-workspace.mjs start",
		"dev": "pnpm run start",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:cli": "wp-env run cli wp",
		"composer:install": "wp-env run cli --env-cwd=wp-content/plugins/wp-typia-newsletter-connector composer install --no-interaction",
		"listmonk:start": "node scripts/listmonk-local.mjs start",
		"listmonk:env": "node scripts/listmonk-local.mjs env",
		"listmonk:logs": "node scripts/listmonk-local.mjs logs",
		"listmonk:stop": "node scripts/listmonk-local.mjs stop",
		"listmonk:destroy": "node scripts/listmonk-local.mjs destroy",
		"smoke:newspack": "node scripts/smoke-newspack.mjs",
		"smoke:listmonk": "node scripts/smoke-listmonk.mjs",
		"smoke:listmonk:local": "node scripts/smoke-listmonk.mjs --env-file .listmonk.env",
		"smoke:listmonk:send:local": "node scripts/smoke-listmonk-send-local.mjs",
		"smoke:listmonk:archive:local": "node scripts/smoke-listmonk-archive-local.mjs",
		"smoke:listmonk:subscribers:local": "node scripts/smoke-listmonk-subscribers-local.mjs",
		"smoke:listmonk:bounces:local": "node scripts/smoke-listmonk-bounces-local.mjs",
		"smoke:staging:zip": "pnpm run release:zip && node scripts/smoke-staging-zip.mjs",
		"doctor:wp-typia": "node scripts/wp-typia-doctor.mjs",
		"e2e:editor:local": "pnpm run build && pnpm run listmonk:start && pnpm exec playwright install chromium && pnpm exec playwright test --config=playwright.config.js tests/e2e/editor-listmonk.spec.ts",
		"e2e:publish-schedule:local": "pnpm run build && pnpm run listmonk:start && pnpm exec playwright install chromium && pnpm exec playwright test --config=playwright.config.js tests/e2e/editor-publish-schedule.spec.ts",
		"e2e:settings:local": "pnpm run build && pnpm run listmonk:start && pnpm exec playwright install chromium && pnpm exec playwright test --config=playwright.config.js tests/e2e/settings-listmonk.spec.ts",
		"e2e:visual:local": "pnpm run build && pnpm exec playwright install chromium && pnpm exec playwright test --config=playwright.config.js tests/e2e/render-visual.spec.ts",
		"test:php": "pnpm run env:start && pnpm run composer:install && wp-env run tests-cli --env-cwd=wp-content/plugins/wp-typia-newsletter-connector vendor/bin/phpunit",
		"test:node": "node --test tests/node/*.test.mjs",
		"test:release": "node --test tests/node/sync-release-version.test.mjs",
		"postinstall": "node scripts/apply-ttsc-lint-compat.mjs",
		"check:code": "pnpm run sync --check && ttsc check --noEmit",
		"check:style": "wp-scripts lint-style --allow-empty-input",
		"check": "pnpm run check:code && pnpm run check:style",
		"format": "wp-scripts format"
	},
	"wpTypia": {
		"projectType": "workspace",
		"templatePackage": "@wp-typia/create-workspace-template",
		"namespace": "wp-typia-newsletter-connector",
		"textDomain": "wp-typia-newsletter-connector",
		"phpPrefix": "newspack_listmonk_connector"
	},
	"devDependencies": {
		"@playwright/test": "^1.59.1",
		"@types/node": "^24.5.2",
		"@types/wordpress__block-editor": "^11.5.17",
		"@types/wordpress__blocks": "^12.5.18",
		"@ttsc/lint": "0.26.2",
		"@ttsc/unplugin": "^0.26.2",
		"@wordpress/browserslist-config": "^6.42.0",
		"@wordpress/env": "11.5.0",
		"@wordpress/scripts": "^30.22.0",
		"@wp-typia/api-client": "^0.5.1",
		"@wp-typia/block-runtime": "^0.10.1",
		"@wp-typia/block-types": "^0.5.1",
		"@wp-typia/project-tools": "^0.28.0",
		"@wp-typia/rest": "^0.4.1",
		"@wp-typia/ttsc-lint-plugin-wp": "^0.2.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"ttsc": "^0.26.2",
		"tsx": "^4.20.5",
		"typescript": "^7.0.2",
		"typia": "^13.2.0"
	},
	"dependencies": {
		"@wordpress/api-fetch": "^7.42.0",
		"@wordpress/block-editor": "^15.2.0",
		"@wordpress/blocks": "^15.2.0",
		"@wordpress/components": "^30.2.0",
		"@wordpress/data": "^10.44.0",
		"@wordpress/editor": "^14.44.0",
		"@wordpress/element": "^6.29.0",
		"@wordpress/i18n": "^6.2.0",
		"@wordpress/interactivity": "^6.29.0",
		"@wordpress/notices": "^5.44.0",
		"@wordpress/plugins": "^7.44.0"
	}
}
